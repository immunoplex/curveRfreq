print(tbl[, c("curve_id", "best_model", "converged", "aic", "a", "b", "c", "d")])
# All sample predictions in one data frame
samp_all <- collect_samples(mp)
cat("Total rows:", nrow(samp_all), "\n")
cat("Columns:", paste(names(samp_all), collapse = ", "), "\n")
