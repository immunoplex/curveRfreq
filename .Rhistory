usethis::use_description(
fields = list(
Title = "Frequentist Calibration Curves for the curveR Suite",
Description = paste(
"Fits an ensemble of nonlinear least-squares (NLS) calibration",
"models (4PL, 5PL, Gompertz) to preprocessed standard curve data",
"using multi-start Levenberg-Marquardt optimisation. Selects the",
"best model by AIC subject to quantification-eligibility gates,",
"and back-calculates sample concentrations with delta-method",
"uncertainty. Produces the calibration_result S3 class defined",
"in curveRcore, making results directly comparable with",
"curveRbayes."
),
`Authors@R` = 'person("Your", "Name", email = "you@example.com",
role = c("aut", "cre"))',
License  = "MIT + file LICENSE",
Encoding = "UTF-8"
)
)
usethis::use_package("curveRcore")
usethis::use_package("minpack.lm")
devtools::document()
pkg    <- pkgdown::as_pkgdown(".")
topics <- pkg$topics[, c("name", "file_in", "title")]
sort(topics$name)
library(yaml)
pkg    <- pkgdown::as_pkgdown(".")
topics <- pkg$topics[, c("name", "file_in", "title")]
cfg <- yaml::read_yaml("_pkgdown.yml")   # reads the stub created by usethis
# ── Theme ──
cfg$template <- list(bootstrap = 5, bootswatch = "flatly")
# ── Home ──
cfg$home <- list(
title       = "curveRfreq",
description = paste(
"Frequentist nonlinear calibration curves for the curveR suite.",
"Multi-start Levenberg-Marquardt NLS with AIC + eligibility-gate",
"model selection and delta-method uncertainty propagation."
)
)
# ── Navbar ──
cfg$navbar <- list(
structure  = list(left = c("intro", "reference", "articles", "news"),
right = "github"),
components = list(
github = list(icon = "fab fa-github",
href = "https://github.com/immunoplex/curveRfreq")
)
)
# ── Reference sections ──
cfg$reference <- list(
list(
title    = "Main Entry Points",
desc     = paste(
"The two functions most users call directly.",
"Both expect preprocessed data on the fitting scale",
"(use curveRcore::preprocess_standards() upstream)."
),
contents = topics$name[topics$name %in%
c("fit_calibration_freq",
"fit_calibration_freq_multiplate")]
),
list(
title    = "Multi-Curve Helpers",
desc     = paste(
"Convenience extractors that operate on",
"calibration_result_multiplate objects."
),
contents = topics$name[topics$name %in%
c("summary_table", "collect_samples")]
),
list(
title    = "NLS Fitting Engine",
desc     = paste(
"Lower-level functions that implement multi-start",
"Levenberg-Marquardt fitting for one plate.",
"Called internally by fit_calibration_freq() but exported",
"for users who need fine-grained control."
),
contents = topics$name[topics$name %in%
c("fit_ensemble_nls",
"compute_model_constraints",
"generate_start_lists")]
),
list(
title    = "Model Selection",
desc     = paste(
"AIC-based ranking and best-parameter extraction.",
"select_best_aic() is a pure ranking step;",
"eligibility gating is handled upstream by",
"curveRcore::select_best_eligible()."
),
contents = topics$name[topics$name %in%
c("select_best_aic", "extract_best_parameters")]
),
list(
title    = "Grid Prediction & Uncertainty",
desc     = paste(
"Evaluates the best-fit model across the prediction grid,",
"computes delta-method confidence intervals on the response,",
"back-calculates concentration, and propagates uncertainty to",
"se_concentration and pcov."
),
contents = topics$name[topics$name %in%
c("predict_grid_freq")]
),
list(
title    = "Sample Back-Calculation",
desc     = paste(
"Applies the analytical model inverse to test-sample responses,",
"propagates uncertainty via the delta method, and multiplies by",
"the dilution factor to produce final_concentration."
),
contents = topics$name[topics$name %in%
c("predict_samples_freq")]
)
)
# ── News ──
cfg$news <- list(one_page = TRUE)
yaml::write_yaml(cfg, "_pkgdown.yml")
assigned <- unlist(lapply(cfg$reference, `[[`, "contents"))
missing  <- setdiff(topics$name, assigned)
missing   # should be empty
